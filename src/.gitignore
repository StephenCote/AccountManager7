# Persistent host data dir for the docker-compose.test.yml stack (Postgres data,
# app keystores/vault/datagen/streams, TLS certs). Runtime state — never commit it.
# Override the location with AM7_DATA_DIR; keep any custom path ignored too.
# Glob (not just `docker-data/`) so suffixed variants — docker-data-test/,
# docker-data.bak, a stray file named docker-data — are covered too.
docker-data*
e2e/results/
e2e/screenshots/

# First-run setup token (docker/entrypoint.sh). Admin-equivalent bootstrap
# credential. Normally lives under the ignored data dir above, but AM7_DATA_DIR
# can point anywhere -- so match it by name wherever it lands.
.setup.token
**/.setup.token
.setup.done
**/.setup.done

# docker-compose default env file. Auto-loaded by `docker compose` run from this
# dir; may hold a real embedding/AI API key (e.g. Azure). NEVER commit it.
# The committed template is .env.example (no secrets).
.env
**/.env
!.env.example
!**/.env.example

# Local test credentials (KI-11). The tracked resource.properties keeps every
# *.authorizationToken blank; SecretTestGate (Objects7 test harness) fills those
# same keys at setup from -D / AM7_* env vars / this file. NEVER commit it.
**/src/test/resources/resource.local.properties
**/src/main/resources/resource.local.properties

# Loose LLM emulator recordings (<sha256>.json recorder drops) are local overrides; the committed copies live in each set's fixtures.zip, and manifest.json stays loose.
AccountManagerObjects7/src/test/resources/llm-fixtures/*/*.json
!AccountManagerObjects7/src/test/resources/llm-fixtures/*/manifest.json
# runaway/ is not an emulator set: hand-named recorded replies (the Ourselves.doc chunk-6 loop) that the runaway-detector tests read directly.
!AccountManagerObjects7/src/test/resources/llm-fixtures/runaway/*.json
# malformed-array/ likewise: the real glitched scene-extraction reply (2026-10-07) that TestLlmJsonArraySalvage reads directly.
!AccountManagerObjects7/src/test/resources/llm-fixtures/malformed-array/*.json