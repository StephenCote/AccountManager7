				<!--
					3.2.5, not 2.22.2. 2.22.2's PpidChecker confirms the parent Maven process is alive by
					shelling out to `wmic`, which Windows 11 (build 26200 here) no longer ships. One second
					into every fork that check threw
					  "IllegalStateException: Cannot use PPID <n> process information. Going to use NOOP events."
					leaving fork liveness resting entirely on ping commands over stdin. When those stalled on
					a long LLM-bound test the fork called System.exit on itself
					  "Killing self fork JVM. PING timeout elapsed."
					which Maven then reported as the misleading "VM crash or System.exit called?" - with no
					hs_err_pid log, because nothing actually crashed. Observed live 2026-08-07 on
					TestPictureBookCustom: killed at 27:31 while mid-LLM call (the app log shows an HTTP 200
					arriving 1.4s before the kill), where the identical 5 tests had passed in 26:20 an hour
					earlier. 3.x replaced the wmic-based checker and adds -Dsurefire.enableProcessChecker=none
					as an explicit escape hatch if this resurfaces.
				-->
				<version>3.2.5</version>
				<dependencies>

					<dependency>
						<groupId>org.apache.maven.surefire</groupId>
						<artifactId>surefire-junit47</artifactId>
						<!-- Kept in lockstep with the plugin version above (was 3.1.2 under a 2.22.2 plugin). -->
						<version>3.2.5</version>
					</dependency>

				</dependencies>

